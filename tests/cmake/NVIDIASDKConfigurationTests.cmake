if(NOT DEFINED SOURCE_DIRECTORY OR NOT DEFINED TEST_DIRECTORY)
    message(FATAL_ERROR "SOURCE_DIRECTORY and TEST_DIRECTORY are required")
endif()

foreach(case IN ITEMS enabled missing incomplete disabled unsupported)
    set(root "${TEST_DIRECTORY}/${case}")
    set(files
        streamline/include/sl.h streamline/include/sl_version.h
        streamline/include/sl_dlss.h streamline/include/sl_dlss_d.h
        streamline/lib/x64/sl.interposer.lib streamline/bin/x64/sl.interposer.dll
        streamline/bin/x64/sl.common.dll streamline/bin/x64/NvLowLatencyVk.dll
        streamline/bin/x64/sl.dlss.dll streamline/bin/x64/nvngx_dlss.dll
        streamline/bin/x64/sl.dlss_d.dll streamline/bin/x64/nvngx_dlssd.dll
        aftermath/include/GFSDK_Aftermath.h
        aftermath/include/GFSDK_Aftermath_GpuCrashDump.h
        aftermath/include/GFSDK_Aftermath_GpuCrashDumpDecoding.h
        aftermath/lib/x64/GFSDK_Aftermath_Lib.x64.lib
        aftermath/lib/x64/GFSDK_Aftermath_Lib.x64.dll)
    if(NOT case STREQUAL "missing")
        list(APPEND files nvperf/NvPerf/include/nvperf_vulkan_target.h
            nvperf/NvPerf/include/windows-desktop-x64/nvperf_host_impl.h
            nvperf/redist/NvPerfUtility/include/NvPerfVulkan.h)
        if(NOT case STREQUAL "incomplete")
            list(APPEND files nvperf/NvPerf/bin/x64/nvperf_grfx_host.dll)
        endif()
    endif()
    foreach(file IN LISTS files)
        get_filename_component(directory "${root}/${file}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(WRITE "${root}/${file}" "")
    endforeach()
    file(WRITE "${root}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(NVIDIASDKFixture NONE)
set(WIN32 TRUE)
set(CMAKE_SIZEOF_VOID_P 8)
if(CASE STREQUAL "unsupported")
    set(CMAKE_SIZEOF_VOID_P 4)
endif()
set(METALLIC_ENABLE_NVPERF ON CACHE BOOL "")
if(CASE STREQUAL "disabled")
    set(METALLIC_ENABLE_NVPERF OFF CACHE BOOL "" FORCE)
endif()
set(METALLIC_NVPERF_SDK_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/nvperf" CACHE PATH "")
set(METALLIC_STREAMLINE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/streamline" CACHE PATH "")
set(METALLIC_STREAMLINE_AUTO_DOWNLOAD OFF CACHE BOOL "")
set(NsightAftermath_SDK "${CMAKE_CURRENT_SOURCE_DIR}/aftermath" CACHE PATH "")
include("${SOURCE_DIRECTORY}/cmake/SetupStreamline.cmake")
include("${SOURCE_DIRECTORY}/cmake/SetupAftermath.cmake")
include("${SOURCE_DIRECTORY}/cmake/SetupNvPerf.cmake")
set(METALLIC_ENABLE_RTXCR ON)
include("${SOURCE_DIRECTORY}/cmake/SetupRTXCR.cmake")
foreach(component IN ITEMS MATERIAL GEOMETRY ASSETS)
    if(NOT METALLIC_RTXCR_${component}_ROOT STREQUAL "")
        message(FATAL_ERROR "Missing RTXCR ${component} was unexpectedly enabled")
    endif()
endforeach()
if(METALLIC_RTXCR_SHADER_INCLUDE_DIR OR METALLIC_RTXCR_GEOMETRY_SHADER_INCLUDE_DIR)
    message(FATAL_ERROR "Missing RTXCR still exposes shader include directories")
endif()
set(METALLIC_ENABLE_NSIGHT_EVENTS ON)
set(ENV{METALLIC_NVTX_ROOT} "")
include("${SOURCE_DIRECTORY}/cmake/SetupNsight.cmake")
get_target_property(nvtx_includes metallic_nsight_events INTERFACE_INCLUDE_DIRECTORIES)
get_target_property(nvtx_definitions metallic_nsight_events INTERFACE_COMPILE_DEFINITIONS)
if(METALLIC_NVTX_INCLUDE_DIR OR nvtx_includes OR nvtx_definitions)
    message(FATAL_ERROR "Missing NVTX still exposes SDK includes or definitions")
endif()
set(expected_nvperf 0)
if(CASE STREQUAL "enabled")
    set(expected_nvperf 1)
endif()
if(NOT METALLIC_HAS_NVPERF EQUAL expected_nvperf)
    message(FATAL_ERROR "Unexpected NvPerf availability: ${METALLIC_HAS_NVPERF}")
endif()
foreach(pair IN ITEMS "nvperf|METALLIC_HAS_NVPERF=${expected_nvperf}"
        "streamline|METALLIC_HAS_STREAMLINE=1"
        "aftermath|METALLIC_HAS_NSIGHT_AFTERMATH=1")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 sdk)
    list(GET parts 1 definition)
    get_target_property(definitions metallic_${sdk} INTERFACE_COMPILE_DEFINITIONS)
    if(NOT definition IN_LIST definitions)
        message(FATAL_ERROR "${sdk} consumers did not receive ${definition}")
    endif()
endforeach()
get_directory_property(definitions COMPILE_DEFINITIONS)
if(definitions)
    message(FATAL_ERROR "SDK definitions leaked to unrelated targets: ${definitions}")
endif()
get_target_property(includes metallic_nvperf INTERFACE_INCLUDE_DIRECTORIES)
if(NOT expected_nvperf AND includes)
    message(FATAL_ERROR "Disabled NvPerf still exposes SDK include directories")
endif()
]=])
    execute_process(COMMAND "${CMAKE_COMMAND}" -G Ninja -S "${root}" -B "${root}/build"
        "-DSOURCE_DIRECTORY=${SOURCE_DIRECTORY}" "-DCASE=${case}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${case} failed:\n${output}\n${errors}")
    endif()
    if(errors MATCHES "CMake Warning")
        message(FATAL_ERROR "${case} emitted a warning for an optional SDK:\n${errors}")
    endif()
endforeach()
message(STATUS "NVIDIA SDK availability and target isolation cases passed")
