cmake_minimum_required(VERSION 3.20)

if(NOT EXISTS "${RHI_EXECUTABLE}")
    message(FATAL_ERROR "Build MetallicRHITests before running its selection tests")
endif()

# Keep developer/CI selection, sharding, repetition and report settings out of
# these subprocesses. Positive selection uses list mode, never the RHI device.
execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE environment
    COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "(^|\n)GTEST_[^=\n]+=" gtest_environment "${environment}")
unset(environment)
foreach(entry IN LISTS gtest_environment)
    string(REGEX REPLACE "[\n=]" "" name "${entry}")
    unset(ENV{${name}})
endforeach()
foreach(name IN ITEMS TESTBRIDGE_TEST_ONLY TESTBRIDGE_TEST_RUNNER_FAIL_FAST
        XML_OUTPUT_FILE TEST_WARNINGS_OUTPUT_FILE)
    unset(ENV{${name}})
endforeach()
get_filename_component(executable_directory "${RHI_EXECUTABLE}" DIRECTORY)
set(case_count 0)
set(failures "")
set(failure_details "")
function(check_selection name expected)
    execute_process(COMMAND "${RHI_EXECUTABLE}" ${ARGN} --gtest_color=no
        --output-dir "${executable_directory}/rhi-selection-output/${name}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    set(valid TRUE)
    if(expected STREQUAL "strict")
        if(NOT result STREQUAL "1" OR NOT "${output}${error}" MATCHES "No tests ran\\. Check that tests exist")
            set(valid FALSE)
        endif()
    elseif(expected STREQUAL "list")
        if(NOT result STREQUAL "0" OR NOT output MATCHES "render_graph_gpu_driven_composed_stream_render")
            set(valid FALSE)
        endif()
    elseif(expected STREQUAL "empty-list")
        if(NOT result STREQUAL "0" OR output MATCHES "render_graph_gpu_driven_composed_stream_render|No tests ran")
            set(valid FALSE)
        endif()
    elseif(expected STREQUAL "empty-run")
        if(NOT result STREQUAL "0" OR NOT output MATCHES "Running 0 tests from 0 test suites")
            set(valid FALSE)
        endif()
    else()
        message(FATAL_ERROR "Unknown selection expectation: ${expected}")
    endif()
    if(name MATCHES "^list-match-" AND output MATCHES "RoundTripNeutralAndKnownPrimaries")
        set(valid FALSE)
    endif()
    if(name MATCHES "^list-all-" AND NOT output MATCHES "RoundTripNeutralAndKnownPrimaries")
        set(valid FALSE)
    endif()
    if(output MATCHES "Global test environment set-up")
        set(valid FALSE)
    endif()
    if(NOT valid)
        list(APPEND failures "${name}")
        string(APPEND failure_details "\n${name}: expected=${expected}, exit=${result}, stdout=${output}, stderr=${error}")
    endif()
    math(EXPR case_count "${case_count} + 1")
    set(case_count "${case_count}" PARENT_SCOPE)
    set(failures "${failures}" PARENT_SCOPE)
    set(failure_details "${failure_details}" PARENT_SCOPE)
endfunction()

set(missing "__metallic_no_such_rhi_test_d2__")
set(current "render_graph_gpu_driven_composed_stream_render")
check_selection(legacy-space strict --filter "${missing}")
check_selection(legacy-equals strict "--filter=${missing}")
check_selection(retired-name strict --filter render_graph_gpu_driven_mixed_producer_render)
check_selection(list-all-legacy list --list)
check_selection(list-all-native list --gtest_list_tests)
check_selection(list-match-space list --filter "${current}" --list)
check_selection(list-match-equals list "--filter=${current}" --gtest_list_tests)
check_selection(list-missing empty-list --filter "${missing}" --list)
check_selection(native-default empty-run "--gtest_filter=${missing}")
check_selection(opt-out-before empty-run --gtest_fail_if_no_test_selected=false --filter "${missing}")
check_selection(opt-out-after empty-run "--filter=${missing}" --gtest_fail_if_no_test_selected=false)
check_selection(native-strict strict "--gtest_filter=${missing}" --gtest_fail_if_no_test_selected)
# Keep the missing-value option last; no trailing output/color flag may supply it.
execute_process(COMMAND "${RHI_EXECUTABLE}" --filter RESULT_VARIABLE missing_result
    OUTPUT_VARIABLE missing_output ERROR_VARIABLE missing_error TIMEOUT 10)
math(EXPR case_count "${case_count} + 1")
if(NOT missing_result STREQUAL "1" OR NOT "${missing_output}${missing_error}" MATCHES "--filter requires a value")
    list(APPEND failures "missing-value")
    string(APPEND failure_details "\nmissing-value: exit=${missing_result}, stdout=${missing_output}, stderr=${missing_error}")
endif()

if(failures)
    list(LENGTH failures failure_count)
    message(FATAL_ERROR "${failure_count}/${case_count} RHI selection cases failed: ${failure_details}")
endif()
message(STATUS "${case_count} RHI selection cases passed (CPU only; positive selection listed, not executed)")
