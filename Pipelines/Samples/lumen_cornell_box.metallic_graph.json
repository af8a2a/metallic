                    ".cache/mesh-distance-field/CornellBoxCeiling.meshdf",
                    ".cache/mesh-distance-field/CornellBoxBackWall.meshdf",
                    ".cache/mesh-distance-field/CornellBoxLeftWall.meshdf",
                    ".cache/mesh-distance-field/CornellBoxRightWall.meshdf",
                    ".cache/mesh-distance-field/CornellBoxShortBlock.meshdf",
                    ".cache/mesh-distance-field/CornellBoxTallBlock.meshdf",
                    ".cache/mesh-distance-field/CornellBoxCeilingEmitter.meshdf"
                ],
                "center": [0, 1, 0], "extent": 1.8, "resolution": 112,
                "maxPhysicalPages": 4096, "quantized": true, "clipmapCount": 1, "buildObjectGrid": true
