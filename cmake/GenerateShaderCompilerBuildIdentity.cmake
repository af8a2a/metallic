cmake_minimum_required(VERSION 3.20)

include("${IDENTITY_INPUTS}")
include("${IDENTITY_RISKS}")
set(_shared TRUE)
if(NOT identity_supported MATCHES "^1/Ninja[^/]*/TRUE/TRUE$")
    set(_shared FALSE)
endif()
string(TOUPPER "${identity_global_ipo};${identity_target_ipo}" _ipo_upper)
string(TOUPPER "${identity_semantics};${identity_target_compile};${identity_global_link};${identity_target_link}" _risk_upper)
if(_ipo_upper MATCHES "(^|[ ;|\t\r\n])(1|ON|TRUE|YES|Y)([ ;|\t\r\n]|$)" OR
   _risk_upper MATCHES "(/GL([ ;|\t\r\n]|$)|/LTCG|/GENPROFILE|/FASTGENPROFILE|/USEPROFILE|-FLTO|-FPROFILE)")
    set(_shared FALSE)
endif()
# Only native MSVC layout/debug flags are known safe here. Any other host link
# contract keeps the configured options and falls back to host-specific reuse.
string(TOUPPER "${identity_global_link};${identity_target_link}" _link_contract)
string(REGEX REPLACE "(/MACHINE:[A-Z0-9_]+|/INCREMENTAL(:NO)?|/DEBUG(:[A-Z]+)?|/SUBSYSTEM:[A-Z]+|/NOLOGO)" "" _link_contract "${_link_contract}")
string(REGEX REPLACE "[ ;\t\r\n]" "" _link_contract "${_link_contract}")
if(NOT _link_contract STREQUAL "")
    set(_shared FALSE)
endif()

# Resolve the standard dynamic CRT and Win32 import archives in the actual build
# environment; no configure-only guess or unqualified omission permits sharing.
cmake_path(GET identity_compiler PARENT_PATH _compiler_directory)
cmake_path(ABSOLUTE_PATH _compiler_directory NORMALIZE OUTPUT_VARIABLE _compiler_directory)
set(_system_search "$ENV{LIB}")
list(APPEND _system_search "${_compiler_directory}/../../../lib/x64")
if(identity_runtime MATCHES "Debug")
    set(_system_names msvcrtd.lib msvcprtd.lib vcruntimed.lib ucrtd.lib kernel32.lib)
else()
    set(_system_names msvcrt.lib msvcprt.lib vcruntime.lib ucrt.lib kernel32.lib)
endif()
if(NOT identity_runtime MATCHES "DLL")
    set(_shared FALSE)
endif()
foreach(_name IN LISTS _system_names)
    unset(_system_file)
    unset(_system_file CACHE)
    find_file(_system_file NAMES "${_name}" PATHS ${_system_search} NO_DEFAULT_PATH)
    if(_system_file)
        list(APPEND identity_files "${_system_file}")
    else()
        set(_shared FALSE)
    endif()
endforeach()
list(REMOVE_DUPLICATES identity_files)
list(FILTER identity_files EXCLUDE REGEX "^$")
set(_payload "metallic-shader-compiler-archive-identity-v1\n${identity_semantics}\n")
foreach(_file IN LISTS identity_files)
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
        message(FATAL_ERROR "Shader compiler identity input unavailable: ${_file}")
    endif()
    file(SHA256 "${_file}" _sha)
    string(APPEND _payload "${_file}=${_sha}\n")
endforeach()
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" _generator_sha)
string(APPEND _payload "generator=${_generator_sha}\n")
string(SHA256 _fingerprint "${_payload}")
if(_shared)
    set(_share_literal true)
else()
    set(_share_literal false)
endif()
set(_provider "#include \"Runtime/Render/Core/ShaderCompilerBuildIdentity.h\"\n\nnamespace metallic::render {\nShaderCompilerBuildIdentity compiledShaderCompilerBuildIdentity() noexcept\n{\n    return {\"${_fingerprint}\", ${_share_literal}};\n}\n} // namespace metallic::render\n")
get_filename_component(_directory "${IDENTITY_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_directory}")
file(WRITE "${IDENTITY_OUTPUT}.pending" "${_provider}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${IDENTITY_OUTPUT}.pending" "${IDENTITY_OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${IDENTITY_OUTPUT}.pending")
file(WRITE "${IDENTITY_OUTPUT}.inputs.txt" "${_payload}\nallowCrossHostReuse=${_share_literal}\n")
function(_identity_dep_escape input result)
    string(REPLACE "\\" "/" _text "${input}")
    string(REPLACE "$" "$$" _text "${_text}")
    string(REPLACE " " "\\ " _text "${_text}")
    string(REPLACE "#" "\\#" _text "${_text}")
    string(REPLACE ":" "\\:" _text "${_text}")
    set(${result} "${_text}" PARENT_SCOPE)
endfunction()
_identity_dep_escape("${IDENTITY_OUTPUT}" _output)
set(_dep "${_output}:")
foreach(_file IN LISTS identity_files)
    _identity_dep_escape("${_file}" _name)
    string(APPEND _dep " ${_name}")
endforeach()
file(WRITE "${IDENTITY_DEPFILE}" "${_dep}\n")
